<script><![CDATA[var rows = JSON.parse(producer.selected_supplies || '[]');
var grandTotal = 0;

for (var i = 0; i < rows.length; i++) {
    var qty = parseInt(rows[i].quantity, 10) || 0;
    var price = parseFloat(rows[i].unit_price) || 0;
    grandTotal += (qty * price);
}

gs.addInfoMessage('Order preview submitted! Total: ' + grandTotal.toFixed(2) + ' across ' + rows.length + ' row(s).');
current.short_description = 'Supply Order for ' + gs.getUserDisplayName();]]></script>
